// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// schema.prisma

// User model representing both admins and customers
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  googleId     String?   @unique
  firstName    String?
  lastName     String?
  password     String?
  gender       String?
  dateOfBirth  DateTime?
  phoneNumber  String?
  address      Address?
  profileImage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isAdmin      Boolean?  @default(false)

  // Relationship to events (one-to-many)
  events Event[] @relation("CreatedByUser")

  // Relationship to bookings (one-to-many)
  bookings Booking[] @relation("UserBookings")

  // Relationship to roles (one-to-many)
  roleId Int
  role   Role @relation(fields:[roleId], references:[id])
  
}

model Address {
  id      Int    @id @default(autoincrement())
  street  String
  city    String
  state   String
  zipCode String
  country String

  user   User? @relation(fields:[userId], references: [id])
  userId Int?
}

model EventType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  // Add other fields as needed
  Event       Event[]
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  location    String
  typeId      Int? // Foreign key referencing the type of event
  type        EventType? @relation(fields: [typeId], references: [id])

  // Relationship to user (many-to-one)
  userId    Int? // Foreign key referencing the user who created the event
  createdBy User? @relation("CreatedByUser", fields: [userId], references: [id])

  // Relationship to bookings (one-to-many)
  bookings Booking[] @relation("BookedEvent")
}

model Booking {
  id          Int     @id @default(autoincrement())
  isConfirmed Boolean @default(false)

  // Relationship to user (many-to-one)
  userId     Int // Foreign key referencing the user who made the booking
  madeByUser User @relation("UserBookings", fields: [userId], references: [id])

  // Relationship to event (many-to-one)
  eventId Int? // Foreign key referencing the event booked
  event   Event? @relation("BookedEvent", fields: [eventId], references: [id])

  // Add other fields as needed for booking information (e.g., payment details, status, etc.)
}
model Role {
  id   Int    @id @default(autoincrement())
  name String @unique
  users User[]
}
